@model List<OfertaEmpleo>
@{
    Layout = "_LayoutNavy";
    ViewData["Title"] = "Ofertas de empleo";
    ViewData["Activo"] = "ofertas";
}
<div class="nv-card">
    <h2 class="nv-h2">Ofertas de empleo</h2>
    <form method="get" class="nv-search">
        <i class="bi bi-search"></i>
        <input name="q" value="@ViewBag.Q" placeholder="Buscar por puesto, empresa o ubicación..." />
        <button type="submit" class="nv-btn">Buscar</button>
    </form>
    @foreach (var o in Model)
    {
        <a class="nv-oferta" asp-controller="Ofertas" asp-action="Detalle" asp-route-id="@o.IdOferta">
            <span class="nv-oferta-ico"><i class="bi bi-buildings-fill"></i></span>
            <span>
                <strong>@o.Titulo</strong>
                <small>@o.Empresa.NombreEmpresa@(string.IsNullOrWhiteSpace(o.Ubicacion) ? "" : " · " + o.Ubicacion) · Publicada el @o.FechaPublicacion.ToString("dd/MM/yyyy")</small>
            </span>
        </a>
    }
    @if (!Model.Any())
    {
        <p class="nv-muted">No se encontraron ofertas.</p>
    }
</div>
