@* Plantilla 5 *@
@model Empresa
@{
    Layout = "_LayoutNavy";
    ViewData["Title"] = "Mi empresa";
    ViewData["Activo"] = "empresa";
    var tab = (string)ViewBag.Tab;
}
<section class="em-card em-head">
    <span class="em-ico"><i class="bi bi-buildings-fill"></i></span>
    <div>
        <h1>@Model.NombreEmpresa</h1>
        <p class="em-sector">@(string.IsNullOrWhiteSpace(Model.Sector) ? "Sector no indicado" : Model.Sector)</p>
        <p class="em-loc"><i class="bi bi-geo-alt"></i> @(string.IsNullOrWhiteSpace(Model.Direccion) ? "Ubicación no indicada" : Model.Direccion)</p>
        <a class="em-btn" asp-action="EditarPerfil">Editar perfil</a>
    </div>
</section>

<nav class="em-card em-tabs">
    <a class="@(tab == "general" ? "active" : "")" asp-action="MiEmpresa" asp-route-tab="general">Información general</a>
    <a class="@(tab == "contacto" ? "active" : "")" asp-action="MiEmpresa" asp-route-tab="contacto">Contacto</a>
    <a class="@(tab == "ubicacion" ? "active" : "")" asp-action="MiEmpresa" asp-route-tab="ubicacion">Ubicación</a>
</nav>

<section class="em-card em-info">
    @if (tab == "general")
    {
        <h2>Información general</h2>
        <p class="em-desc">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Agrega una descripción de tu empresa desde “Editar perfil”." : Model.Descripcion)</p>
        <div class="em-row"><i class="bi bi-geo-alt"></i><div><small>Ubicación</small><span>@(string.IsNullOrWhiteSpace(Model.Direccion) ? "—" : Model.Direccion)</span></div></div>
        <div class="em-row"><i class="bi bi-telephone"></i><div><small>Teléfono</small><span>@(string.IsNullOrWhiteSpace(Model.Telefono) ? "—" : Model.Telefono)</span></div></div>
    }
    else if (tab == "contacto")
    {
        <h2>Contacto</h2>
        <div class="em-row"><i class="bi bi-envelope"></i><div><small>Correo electrónico</small><span>@Model.Usuario.Correo</span></div></div>
        <div class="em-row"><i class="bi bi-telephone"></i><div><small>Teléfono</small><span>@(string.IsNullOrWhiteSpace(Model.Telefono) ? "—" : Model.Telefono)</span></div></div>
    }
    else
    {
        <h2>Ubicación</h2>
        <div class="em-row"><i class="bi bi-geo-alt"></i><div><small>Dirección</small><span>@(string.IsNullOrWhiteSpace(Model.Direccion) ? "—" : Model.Direccion)</span></div></div>
    }
</section>
