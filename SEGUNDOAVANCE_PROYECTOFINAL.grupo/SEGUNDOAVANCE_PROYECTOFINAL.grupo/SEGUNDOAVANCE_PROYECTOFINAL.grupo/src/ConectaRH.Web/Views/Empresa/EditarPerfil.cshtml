@model DatosEmpresaModel
@{
    Layout = "_LayoutNavy";
    ViewData["Title"] = "Editar empresa";
    ViewData["Activo"] = "empresa";
}
<section class="em-card em-info">
    <h2>Editar información de la empresa</h2>
    <form method="post" asp-action="EditarPerfil" class="nv-form">
        <label>Nombre de la empresa<input name="NombreEmpresa" value="@Model.NombreEmpresa" maxlength="150" required /></label>
        <label>Sector<input name="Sector" value="@Model.Sector" maxlength="100" placeholder="Tecnología" /></label>
        <label>Dirección<input name="Direccion" value="@Model.Direccion" maxlength="200" placeholder="San Salvador, El Salvador" /></label>
        <label>Teléfono<input name="Telefono" value="@Model.Telefono" maxlength="20" /></label>
        <label>Descripción<textarea name="Descripcion" rows="5">@Model.Descripcion</textarea></label>
        <div class="nv-actions">
            <button class="em-btn" type="submit">Guardar cambios</button>
            <a class="nv-link" asp-action="MiEmpresa">Cancelar</a>
        </div>
    </form>
</section>
