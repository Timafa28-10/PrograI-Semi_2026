@model ResumenReportes
@{
    Layout = "_LayoutAdmin";
    ViewData["Titulo"] = "Inicio";
    ViewData["Icono"] = "bi-house-door-fill";
    ViewData["Activo"] = "inicio";
    ViewData["Variante"] = "b";
}
<section class="adm-panel">
    <h2>Panel del administrador</h2>
    <div class="adm-tiles">
        <a class="adm-tile" asp-action="Usuarios"><i class="bi bi-person-fill"></i><strong>@Model.TotalUsuarios</strong><span>Gestionar usuarios</span></a>
        <a class="adm-tile" asp-action="Clientes"><i class="bi bi-buildings-fill"></i><strong>@Model.Empresas</strong><span>Gestión de clientes</span></a>
        <a class="adm-tile" asp-action="Ofertas"><i class="bi bi-briefcase-fill"></i><strong>@(Model.OfertasPublicadas + Model.OfertasPausadas + Model.OfertasCerradas)</strong><span>Gestionar ofertas</span></a>
        <a class="adm-tile" asp-action="Roles"><i class="bi bi-shield-lock-fill"></i><strong>3</strong><span>Roles y permisos</span></a>
        <a class="adm-tile" asp-action="Reportes"><i class="bi bi-bar-chart-fill"></i><strong>@Model.Postulaciones</strong><span>Reportes</span></a>
    </div>
</section>
